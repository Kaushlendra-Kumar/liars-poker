{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liars-poker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // SQLite-backed Durable Objects are what the free plan allows.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    // Comma-separated browser origins allowed to connect, e.g. your Vercel
    // URL. Empty or "*" allows any origin.
    "ALLOWED_ORIGINS": "https://liars-poker-eight.vercel.app"
  },
  "observability": { "enabled": true }
}
