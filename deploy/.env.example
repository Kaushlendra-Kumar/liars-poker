# Copy to deploy/.env and edit. Nothing here is a secret: the server holds no
# credential of its own, and the only secret in the system is the per-player
# rejoin token, which is minted at runtime and never stored.

# The public origin, used for the server's Origin check and baked into the
# client bundle at build time. Must match exactly what a browser sends.
PUBLIC_HOST=liars-poker.example.com
PUBLIC_ORIGIN=https://liars-poker.example.com
PUBLIC_WS_ORIGIN=wss://liars-poker.example.com/ws

# Image tag, stamped into the binary and used for rollback.
VERSION=v1.0.0

# TLS material. Point at a certbot/acme directory holding fullchain.pem and
# privkey.pem.
TLS_CERT_DIR=./nginx/certs

# Observability
LOG_LEVEL=info

# Turn budget and reveal window. The rules specify 30s and 6s; raise the turn
# budget if your players are new to the UI. Changing these changes how the
# game feels, so decide deliberately rather than drifting.
TURN_DURATION=30s
REVEAL_DURATION=6s

# Resource protection. These bound what one host will accept; they are not
# gameplay settings, and the 4-9 player rule is fixed in the engine.
MAX_ROOMS=512
MAX_CONNS_PER_ROOM=32
MAX_CONNS_PER_PLAYER=4
MAX_HANDSHAKES=256
IDLE_TIMEOUT=30m
SHUTDOWN_GRACE=15s
